#!/usr/bin/env bash
# myclaude — Claude Code wrapper (cc-mysub client, v4 split-egress)
# 由 cc-mysub add-device 生成。本机只持 per-device 占位 token + cc-mysub CA 公证书；
# 真 setup-token 永不出 cc-mysub。只有 Anthropic 流量经 cc-mysub(外层 TLS+MITM 换 token)，
# 其余一切(WebFetch/MCP/更新/第三方)由本地 helper 直连、不碰 cc-mysub。
set -euo pipefail

# ============ 本设备配置(由 cc-mysub add-device 生成) ============
PUBLIC_HOST="{{.PublicHost}}"   # cc-mysub 外层 TLS 身份(证书 SAN)，helper 用它验证
PROXY_ENTRY="{{.FrpsIP}}:{{.ProxyPort}}"  # helper 直拨的 cc-mysub forward-proxy 入口
DEVICE_TOKEN="{{.DeviceToken}}" # 代理侧为本设备签的占位 token(sha256 入 devices.json)
SUB_TYPE="{{.SubType}}"         # 订阅档: Max 标签 + auto mode + 1M 可用性
CA_CERT="{{.CACertPath}}"       # cc-mysub CA 公证书路径(由 add-device 下发, 拷到本设备)
# 可选小模型(是否启用/用哪个由你决定; 不设用 CC 默认):
# export ANTHROPIC_SMALL_FAST_MODEL="<small-model-id>"
# ===============================================================

# 1) 订阅认证 env(全是占位/声明, 无真凭据); base_url 保持默认(不导出); HTTPS_PROXY 由 helper 注入
export CLAUDE_CODE_OAUTH_TOKEN="$DEVICE_TOKEN"
export CLAUDE_CODE_OAUTH_SCOPES="user:inference"
export CLAUDE_CODE_SUBSCRIPTION_TYPE="$SUB_TYPE"
export NODE_EXTRA_CA_CERTS="$CA_CERT"   # 信任 cc-mysub CA(验证其 MITM 的 api.anthropic.com 证书)

# 2) 跳过启动预检(platform.claude.com 的 /hello 写死, 纯净设备会卡这)
CJSON="${HOME}/.claude.json"
if ! grep -qs '"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true' "$CJSON"; then
  if [ -s "$CJSON" ] && command -v jq >/dev/null 2>&1; then
    tmp="$(mktemp)" && jq '.hasCompletedOnboarding = true' "$CJSON" >"$tmp" && mv "$tmp" "$CJSON"
  else
    printf '{"hasCompletedOnboarding": true}\n' >"$CJSON"
  fi
fi

# 3) 经 cc-mysub helper 启动 claude: helper 绑本地分流器(Anthropic→cc-mysub, 其余直连)
#    并把 HTTPS_PROXY 注入 claude 子进程。纯用户态分流, 不改主机网络/DNS。
exec cc-mysub helper --upstream "$PROXY_ENTRY" --server-name "$PUBLIC_HOST" --ca "$CA_CERT" -- claude "$@"
